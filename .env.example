# Copy this file to .env and fill in what you need. NEVER commit .env (it is in .gitignore).
#
# The app starts, serves the dashboard and runs the offline evaluation with no keys at all.
# POST /api/chat needs one LLM provider key; without it the API answers 503 "No LLM provider configured".

# Which provider to use: gemini or openai. Leave empty to auto-detect (Gemini first if its key is set).
LLM_PROVIDER=

# Primary provider: Google Gemini (google-genai SDK)
GEMINI_API_KEY=
# Model names change: Google retires models for new users (gemini-2.5-flash now answers HTTP 404 "no longer
# available to new users"). If chat fails with a 404 or 503, see the README "Troubleshooting" section.
GEMINI_MODEL=gemini-3.6-flash

# Optional alternative provider: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite file for memory, conversation history, support requests and traces (relative paths are from the project root)
DATABASE_PATH=data/campuspilot.sqlite3

# Handbook retrieval tuning (optional; see README "Handbook retrieval"). Defaults shown.
# HANDBOOK_MIN_SCORE=0.40
# HANDBOOK_STRONG_SCORE=0.50
